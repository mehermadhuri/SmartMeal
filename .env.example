# SmartMeal — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file.

# ─── Database ───────────────────────────────────────────────────────────────
# Local MySQL (development)
DB_URL=jdbc:mysql://localhost:3306/smartmeal?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=changeme

# Aiven Cloud MySQL (production) — replace placeholders
# DB_URL=jdbc:mysql://<host>:<port>/smartmeal?useSSL=true&requireSSL=true&serverTimezone=Asia/Kolkata
# DB_USERNAME=<aiven_user>
# DB_PASSWORD=<aiven_password>

# ─── JWT ────────────────────────────────────────────────────────────────────
# Use a long random secret in production (min 32 chars)
JWT_SECRET=SmartMealSecretKeyForJwtAuthentication2026SecureCollegeCanteen
JWT_EXPIRATION=86400000

# ─── AI Service ─────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ─── CORS (set to your deployed frontend URL in production) ─────────────────
# ALLOWED_ORIGINS=https://your-frontend-url.vercel.app
